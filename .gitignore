# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ─── Environment / Secrets ───────────────────────────────────────
.env
.env.local
*.pem
*.key
*.crt

# ─── Database runtime files ──────────────────────────────────────
# SQLite files in runtime/ are ephemeral — regenerated on startup
runtime/
*.sqlite3
# Keep *.db and *.sqlite out of repo but allow data/ CSVs
*.db

# ─── IDE / OS ────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log

# ─── Jupyter ─────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ─── Large optional artifacts (regenerated by train_model.py) ────
# Keep .joblib model artifacts — required for the demo to run without retraining
# !models/
reports/figures/shap_bar.png
reports/figures/shap_beeswarm.png
reports/figures/shap_values.npy
reports/figures/shap_sample.npy

# ─── DO NOT ignore these (required for deployment) ───────────────
# models/*.joblib      → pre-trained model, must ship with repo
# data/synthetic/*.csv → seeds the demo database on startup
# data/raw/            → source workbook for reproducibility
